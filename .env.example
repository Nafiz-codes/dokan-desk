# OpenAI: get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any OpenAI model with vision + structured outputs
OPENAI_MODEL=gpt-6.1-terra
# none | low | medium | high  (low = fast for live demos)
OPENAI_REASONING=low

# Optional alternative: used only if OPENAI_API_KEY is empty
# XAI_API_KEY=
# XAI_MODEL=grok-4.7

# Stripe TEST mode secret key (sk_test_...). Leave empty to keep "Pay now" disabled
STRIPE_SECRET_KEY=
# Optional: only if you set up a webhook (stripe listen --forward-to localhost:3000/api/webhook)
STRIPE_WEBHOOK_SECRET=
# Optional: used for the USD fallback if your Stripe account can't charge BDT
BDT_PER_USD=122
